# Copie ce fichier en .env pour personnaliser le build (ne commite jamais .env).

# URL publique du site (canonical, Open Graph, sitemap). Sans slash final.
VITE_SITE_URL=https://ethanbacquier.github.io

# Chemin de base. "/" pour https://ethanbacquier.github.io (repo ethanbacquier/ethanbacquier.github.io)
# ou pour un domaine perso.
VITE_BASE=/

# Clé d'accès Web3Forms (https://web3forms.com, gratuite). Vide : le formulaire est remplacé par un lien e-mail.
VITE_FORM_KEY=
